world_address = "0x07a079295990e43441a7389fdc3b9ba063c6cd6aee16fb846f598c42a9f04ff7"
# Cartridge's RPC now refuses unauthenticated requests ("Unauthorized"),
# which stalled indexing at block 17,400,341 (2026-11-03). Provable's public
# mainnet RPC (also used by lootsurvivor.io).
rpc = "https://rpc.provable.games/rpc"

[server]
http_addr = "0.0.0.0"
http_port = ${PORT}
http_cors_origins = ["*"]

[events]
raw = false

[sql]
all_model_indices = false

[indexing]
# Provable's RPC (spec 0.10) rejects the "pending" block tag, so index
# confirmed blocks only.
pending = false
# WORLD contract deployed at block 2407079 (confirmed via RPC binary search);
# no ERC721 contracts tracked here anymore so there's no earlier history to
# capture — safe to start right before the world's own deployment.
world_block = 2400000
transactions = false
external_contracts = false
namespaces = ["ARCADE"]
# No `contracts` list: Beast NFT data (name/image/attributes) comes from the
# @provable-games/collectables SDK in the app, joined by token_id against
# ARCADE-Order — torii only needs to index the marketplace models themselves.

[[sql.model_indices]]
model_tag = "ARCADE-Listing"
fields = ["collection", "status", "category"]

[[sql.model_indices]]
model_tag = "ARCADE-Listing"
fields = ["collection", "token_id", "status", "category"]

[[sql.model_indices]]
model_tag = "ARCADE-Listing"
fields = ["time"]

[[sql.model_indices]]
model_tag = "ARCADE-Offer"
fields = ["owner", "category"]

[[sql.model_indices]]
model_tag = "ARCADE-Offer"
fields = ["collection", "category", "status"]

[[sql.model_indices]]
model_tag = "ARCADE-Offer"
fields = ["collection", "token_id", "category", "status"]

[[sql.model_indices]]
model_tag = "ARCADE-Offer"
fields = ["time"]

[[sql.model_indices]]
model_tag = "ARCADE-Sale"
fields = ["from"]

[[sql.model_indices]]
model_tag = "ARCADE-Sale"
fields = ["to"]

[[sql.model_indices]]
model_tag = "ARCADE-Sale"
fields = ["order.collection"]

[[sql.model_indices]]
model_tag = "ARCADE-Sale"
fields = ["order.collection", "order.token_id"]

[[sql.model_indices]]
model_tag = "ARCADE-Sale"
fields = ["time"]
